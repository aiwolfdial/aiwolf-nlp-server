{% for decorator in decorators -%}
{{ decorator }}
{% endfor -%}
class {{ class_name }}({{ base_class }}):
{%- if description %}
    {{ description }}
{%- endif %}
{%- for field in fields %}
    {{ field.name }} = {{ field.default }}
{%- endfor %}
{#- 列挙値の付随属性は schema/enum_attributes.json から渡される #}
{%- if enum_attrs %}
{%- for prop, meta in enum_attrs["properties"].items() %}

    @property
    def {{ prop }}(self) -> {{ meta["type"] }}:
        """{{ meta["description"] }}"""
        return {
        {%- for value, attrs in enum_attrs["values"].items() %}
            {{ class_name }}.{{ value }}: {% if meta["type"] == "bool" %}{{ attrs[prop] }}{% else %}{{ meta["type"] }}.{{ attrs[prop] }}{% endif %},
        {%- endfor %}
        }[self]
{%- endfor %}
{%- endif %}
